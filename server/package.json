{
  "name": "aura-server",
  "version": "1.0.0",
  "private": true,
  "description": "Server di Aura su Cloudflare Workers: promemoria Web Push e casella del Comando Rapido di Siri",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute aura --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute aura --local --file=schema.sql",
    "vapid": "node scripts/vapid.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "wrangler": "^4.156.1"
  }
}
